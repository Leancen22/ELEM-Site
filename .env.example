# URL pública del sitio (usada en metadata, sitemap y canonicals)
NEXT_PUBLIC_SITE_URL=https://elem.uy

# --- Formulario de contacto (Zoho Mail SMTP) ---
# Buzón Zoho que autentica y envía los correos.
ZOHO_SMTP_USER=contacto@elem.uy
# Contraseña de aplicación de Zoho (NO la del login; genérala en Zoho > Seguridad).
ZOHO_SMTP_PASS=
# Destino de los mensajes del formulario (por defecto: site.email).
CONTACT_TO=contacto@elem.uy
# Host/puerto SMTP. Datacenter global: smtp.zoho.com | UE: smtp.zoho.eu
# Puerto 465 (SSL) o 587 (STARTTLS).
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465

# --- CAPTCHA del formulario (Cloudflare Turnstile) ---
# Claves del widget (dash.cloudflare.com > Turnstile > Add widget).
# Si NO se definen, el formulario sigue funcionando con honeypot + Origin y la
# verificación de captcha se omite. En dev, sin estas vars se usan las claves
# de prueba de Cloudflare (siempre aprueban).
# Site key (pública, va en el cliente):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADrEDyOBFozd7ory
# Secret key (privada, valida el token en el servidor):
TURNSTILE_SECRET_KEY=0x4AAAAAADrED_Oot4HI688nqqaOFpEz6v0

# --- Analytics (Google Analytics 4) ---
# El Measurement ID por defecto está en src/lib/site.ts (gaId) y solo se carga
# en builds de producción. Esta variable lo reemplaza; vacía, desactiva GA.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
